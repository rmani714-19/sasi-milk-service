# ---------------------------------------------------------------------------
# SASI Weight Bridge configuration
# Copy to `.env` and adjust for the collection PC + the actual scale.
# ---------------------------------------------------------------------------

# HTTP + WebSocket port the PWA talks to (must match VITE_WEIGHT_BRIDGE_URL).
HTTP_PORT=8787

# --- serial port -----------------------------------------------------------
# Windows: COM3 / COM4 ...   Linux: /dev/ttyUSB0   macOS: /dev/tty.usbserial-XXXX
# Run `npm run ports` to list what's attached.
SCALE_PORT=/dev/tty.usbserial-0001
BAUD_RATE=9600
DATA_BITS=8
STOP_BITS=1
# parity: none | even | odd | mark | space
PARITY=none
# line delimiter the scale sends between frames (\r, \n or \r\n)
LINE_DELIMITER=\r\n

# --- frame parsing -------------------------------------------------------------
#  IMPORTANT: the iScale i-05-RS232 frame layout is NOT assumed here.
#  1. Run `npm run sniff` and watch the raw frames the scale actually sends.
#  2. Set WEIGHT_REGEX (JS regex) so it captures a named group `weight`
#     (a decimal number) and, if present, `unit` and `stable`.
#  The default below is a permissive starting point that matches most
#  "continuous print" scales — REPLACE it once you have seen real frames.
#
#  Common formats seen in the field (examples only — confirm against YOUR device):
#    "ST,GS,+  012.450 kg\r\n"   ->  ^(?<stable>ST|US),\w{2},(?<sign>[+-])\s*(?<weight>\d+(?:\.\d+)?)\s*(?<unit>kg|g)
#    "+012.450kg\r\n"            ->  (?<sign>[+-]?)(?<weight>\d+(?:\.\d+)?)\s*(?<unit>kg|g)
#    "W:  12.450 KG  ST\r\n"     ->  (?<weight>\d+(?:\.\d+)?)\s*(?<unit>KG|kg|g).*(?<stable>ST|US)?
WEIGHT_REGEX=(?<sign>[+-]?)\s*(?<weight>\d+(?:\.\d+)?)\s*(?<unit>kg|KG|kG|Kg|g|G|lb|LB)?
# optional: separate regex that, if it MATCHES a frame, marks it stable.
# leave blank to rely on WEIGHT_REGEX's own `stable` group or on the
# client-side stability window below.
STABLE_REGEX=

# weight is reported in this unit when WEIGHT_REGEX has no `unit` group
DEFAULT_UNIT=kg

# --- client-side stability fallback -----------------------------------------
# Used only when the scale itself does not tell us "stable".
# The reading counts as stable when it stays within STABLE_THRESHOLD_KG
# for STABLE_DURATION_MS.
STABLE_THRESHOLD_KG=0.02
STABLE_DURATION_MS=700

# --- tare / zero -----------------------------------------------------------
# Only set this if the iScale i-05-RS232 manual documents a remote tare
# command. Give it as an escaped ASCII string ("T\r") or hex ("0x54 0x0D").
# If left blank the bridge will NOT fake a tare — the PWA tells the operator
# to press the physical ZERO/TARE button.
TARE_COMMAND=

# --- misc ----------------------------------------------------------------------
# how long a frame is considered "fresh" (ms). Older -> scale marked stale.
FRAME_STALE_MS=2500
# serial auto-reconnect delay (ms)
RECONNECT_MS=2000
LOG_LEVEL=info
