{
  "name": "sasi-weight-bridge",
  "version": "1.0.0",
  "private": true,
  "description": "Local RS-232 bridge between an iScale i-05-RS232 weighing machine and the SASI MILK SERVICE PWA",
  "type": "commonjs",
  "bin": {
    "sasi-weight-bridge": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "mock": "MOCK=1 node src/index.js",
    "sniff": "node src/sniff.js",
    "ports": "node -e \"require('serialport').SerialPort.list().then(l=>l.forEach(p=>console.log(p.path, '-', p.manufacturer||'?', p.friendlyName||'')))\""
  },
  "dependencies": {
    "@serialport/parser-readline": "^12.0.0",
    "dotenv": "^16.6.1",
    "serialport": "^12.0.0",
    "ws": "^8.21.3"
  },
  "engines": {
    "node": ">=18"
  }
}
