# Frontend build-time config. Copy to `.env` to override.

# Base URL of the local Weight Bridge (see ../weight-bridge) used by the
# Milk Collection screen in "Automatic Scale" mode. Must point at the machine
# the operator runs the bridge on — usually the same PC as the browser.
# Default when unset: http://localhost:8787
VITE_WEIGHT_BRIDGE_URL=http://localhost:8787
